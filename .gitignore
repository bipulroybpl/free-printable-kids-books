# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Large / working design files (keep repo lightweight)
*.psd
*.ai
*.xcf
*.tif
*.tiff

# Note: raw AI-generated drafts (books/**/assets/raw/) ARE tracked, not
# ignored -- the image-generation workflow commits them to a PR branch so a
# human can review before promoting anything to assets/final/. Don't add an
# ignore rule here for assets/raw/ or that review flow silently breaks (the
# PR-creation step finds no diff and never opens).

# Font binaries (documented in shared_assets/fonts/README.md, not vendored)
shared_assets/fonts/*.ttf
shared_assets/fonts/*.otf

# Node/build tooling if a renderer is added later
node_modules/
dist/
